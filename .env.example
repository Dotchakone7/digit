# =============================================================================
#  Application
# =============================================================================
APP_NAME="Digit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# Comma-separated IPs of your load balancer / reverse proxy (or * behind a trusted proxy).
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
#  Database (PostgreSQL)
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=digit
DB_USERNAME=digit
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only cookies).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# =============================================================================
#  Storage — product images use the "public" disk (php artisan storage:link).
#  For S3-compatible storage set SHOP_MEDIA_DISK=s3 and the AWS_* variables.
# =============================================================================
FILESYSTEM_DISK=local
SHOP_MEDIA_DISK=public
SHOP_UPLOAD_MAX_KB=4096
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
#  Mail (order confirmations, password resets)
# =============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="boutique@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
#  Shop identity & contact (colors/fonts: resources/css/theme.css)
# =============================================================================
SHOP_NAME="${APP_NAME}"
SHOP_TAGLINE="Des produits choisis, livrés chez vous."
# Paths relative to /public, e.g. images/brand/logo.svg — empty = text logo.
SHOP_LOGO=
SHOP_LOGO_DARK=
SHOP_FAVICON=favicon.svg
SHOP_CURRENCY=XOF
SHOP_CURRENCY_SYMBOL=FCFA
SHOP_CURRENCY_DECIMALS=0
SHOP_ORDER_PREFIX=CMD
SHOP_LOW_STOCK_THRESHOLD=5
SHOP_RETURN_WINDOW_DAYS=14
# Contact details (can also be edited in Admin > Paramètres).
SHOP_CONTACT_EMAIL=
SHOP_CONTACT_PHONE=
SHOP_CONTACT_WHATSAPP=
SHOP_CONTACT_ADDRESS=
SHOP_OPENING_HOURS=
SHOP_SOCIAL_FACEBOOK=
SHOP_SOCIAL_INSTAGRAM=
SHOP_SOCIAL_TIKTOK=
SHOP_SOCIAL_X=
SHOP_SOCIAL_YOUTUBE=
SHOP_SOCIAL_LINKEDIN=
# Notification channels for customers (mail,database — add sms/whatsapp once implemented).
SHOP_NOTIFICATION_CHANNELS=mail,database
# Receives an e-mail for every new order (optional).
SHOP_ADMIN_NOTIFICATION_EMAIL=

# =============================================================================
#  Payments
# =============================================================================
# Gateways offered at checkout, in order: cash_on_delivery, manual_mobile_money, sandbox
PAYMENT_GATEWAYS=cash_on_delivery,manual_mobile_money
PAYMENT_EXPIRATION_MINUTES=60
# Merchant Mobile Money numbers for manual transfers (empty = operator hidden).
MOMO_ACCOUNT_NAME=
MOMO_ORANGE_NUMBER=
MOMO_MTN_NUMBER=
MOMO_MOOV_NUMBER=
MOMO_WAVE_NUMBER=
# Local simulator of an online provider (never active in production).
# Generate with: php -r "echo bin2hex(random_bytes(32));"
PAYMENT_SANDBOX_SECRET=

# =============================================================================
#  Delivery — "Contacter un livreur" (also editable in Admin > Paramètres)
# =============================================================================
COURIER_DRIVER=link
COURIER_NAME=
COURIER_URL=
COURIER_PHONE=
COURIER_WHATSAPP=
COURIER_NOTES=

# =============================================================================
#  Optional shopping assistant (chat widget)
# =============================================================================
ASSISTANT_ENABLED=false
ASSISTANT_DRIVER=rules
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_BASE_URL=

VITE_APP_NAME="${APP_NAME}"
